# ─────────────────────────────────────────────────────────────
# paxa monorepo — root ignore (mobile / server / shared)
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
**/dist/
**/build/
.logic-build/
*.tsbuildinfo

# Env / secrets — NEVER commit real values (keep *.example files)
.env
.env.*
!.env.example
!.env.production.example
*.keystore
!android/app/debug.keystore
keystore.properties
mobile/android/local.properties

# Compiled JS emitted next to shared TS sources (built on demand)
shared/src/*.js
shared/src/*.js.map
shared/src/*.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Android
**/.gradle/
**/.cxx/
mobile/android/app/build/
mobile/android/build/
mobile/android/captures/
*.apk
*.aab
*.hprof

# iOS
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/*.xcworkspace
*.xcuserstate
DerivedData/

# React Native / Metro
.metro-health-check*
.haste_cache/
*.jsbundle

# Testing / coverage
coverage/
*.lcov

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
