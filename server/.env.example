# Copy to .env and fill in. NEVER commit .env.

# Supabase Postgres connection string (Project Settings → Database → Connection string → URI).
# Use the pooled "Transaction" connection (port 6543) for serverless, or 5432 for a long-lived server.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-long-random-string
# JWT_REFRESH_SECRET is reserved for future JWT-based refresh tokens.
# Current refresh tokens are opaque (not JWTs), so this is optional.
# JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Server
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for the (optional) web client; the native app sends no Origin.
CORS_ORIGINS=http://localhost:5173

# --- Social sign-in (optional; leave empty to disable that provider) ---
# Google: every OAuth client id the app may present, comma-separated
#   (Web client id + iOS client id + Android client id from Google Cloud console).
GOOGLE_CLIENT_IDS=
# Apple: your app bundle id(s) / Services ID, comma-separated.
APPLE_CLIENT_IDS=
# Requires: npm i google-auth-library apple-signin-auth  (already in package.json)
