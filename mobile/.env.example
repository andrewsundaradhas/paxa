# Copy to `.env` for local development. Never commit real secrets.
# Production builds use `.env.production` (see DEPLOYMENT.md).

API_BASE_URL=http://10.0.2.2:4000
APP_ENV=development
SENTRY_DSN=

# Google sign-in — the Web client id (a.k.a. server client id) from Google Cloud.
# The server must list this same id in GOOGLE_CLIENT_IDS. iOS also needs the iOS id.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
